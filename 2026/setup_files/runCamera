#!/bin/sh
# Starts the vision supervisor. Run by runCamera.service (working directory = the 2026 folder).
# Output goes to the system journal:  journalctl -u runCamera -f

VENV_DIR="$HOME/robo2025"     # must match VENV_DIR in setup.sh

# Wait up to 30 s for the robot-network address. Not strictly needed (NetworkTables
# reconnects on its own), but it keeps the startup log readable. Never waits forever.
WAITED=0
while [ "$WAITED" -lt 30 ]; do
    if ip -4 -o addr show | grep -q "inet 10\.24\.29\."; then
        break
    fi
    sleep 1
    WAITED=$((WAITED + 1))
done
echo "IP addresses: $(hostname -I)"

export PYTHONUNBUFFERED=1
. "$VENV_DIR/bin/activate"

# The hostname picks this board's camera list.
HOST="$(hostname -s)"
FRC_JSON="wpilib_frcjsons/${HOST}.json"
echo "Hostname: $HOST"

if [ ! -f "$FRC_JSON" ]; then
    echo "ERROR: $FRC_JSON not found. Set the hostname with setup_files/set_identity.sh"
    exit 1
fi

# exec: Python replaces this shell, so systemd's stop signal goes straight to Python.
exec python3 main_multi_processor.py --autorestart --vision config/vision.json --frc "$FRC_JSON"
